<Window x:Class="Flights_GUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Flights_GUI"
        mc:Ignorable="d"
        Title="Repülő járatok" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <GroupBox Header="Szűrés" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10" Margin="0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Label FontWeight="Bold" Content="Célállomás:" HorizontalAlignment="Right"/>
                <Label FontWeight="Bold" Content="Légitársaság:" Grid.Row="1" HorizontalAlignment="Right"/>
                <TextBox x:Name="name_TXB" Grid.Column="1" Width="200" Height="20" Text="{Binding SearchedDestination}"/>
                <ComboBox x:Name="category_CBX" Grid.Column="1" Grid.Row="1" Height="20" ItemsSource="{Binding Airlines}" DisplayMemberPath="Name" SelectedItem="{Binding SearchedAirline}"/>
                <Button x:Name="search_BTN" Content="Keresés" Grid.Column="2" Grid.RowSpan="2" Width="120" Height="40" Margin="10" Click="search_BTN_Click"/>
            </Grid>
        </GroupBox>
        <DataGrid Grid.Row="1" SelectionMode="Single" AutoGenerateColumns="False" IsReadOnly="True" ItemsSource="{Binding Flights}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Width="Auto" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Célállomás" Width="*" Binding="{Binding Destination}"/>
                <DataGridTextColumn Header="Légitársaság" Width="*" Binding="{Binding Airline.Name}"/>
                <DataGridTextColumn Header="Kapu" Width="*" Binding="{Binding Gate}"/>
                <DataGridTextColumn Header="Dátum" Width="*" Binding="{Binding Date, StringFormat=yyyy.MM.dd HH:mm}"/>
                <DataGridTextColumn Header="Hossz (óra)" Width="Auto" Binding="{Binding FlightDurationStr}"/>
                <DataGridTextColumn Header="Ár" Width="*" Binding="{Binding Price, StringFormat='{}{0:N0} Ft',ConverterCulture=hu-HU}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
